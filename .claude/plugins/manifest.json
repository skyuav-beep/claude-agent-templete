{
  "name": "claude-agent-template",
  "version": "3.8.0",
  "description": "5-layer agent operations template: Memory, Skills, Hooks, Subagents, Plugins",
  "compatibility": {
    "claude_code": "full automation via .claude layers",
    "codex": "native skills via .agents/skills with .codex compatibility workflows"
  },
  "install_policy": {
    "merge_block": [
      "AGENTS.md",
      "CLAUDE.md"
    ],
    "project_owned": [
      "STATE.md",
      "DESIGN.md",
      "docs/project-guide.md"
    ],
    "seed_only": [
      ".claude/settings.template.json"
    ],
    "managed_prefixes": [
      ".claude/skills/",
      ".claude/commands/",
      ".claude/hooks/",
      ".claude/agents/",
      ".agents/skills/",
      ".codex/",
      "designs/"
    ],
    "customizable_prefixes": [
      "agents/",
      "templates/",
      "docs/"
    ]
  },
  "layers": {
    "L1_memory": {
      "description": "프로젝트 메모리 및 상태 관리 파일",
      "files": [
        {
          "path": "CLAUDE.md",
          "description": "Claude Code CLI operation settings"
        },
        {
          "path": ".claude/CLAUDE.md",
          "description": "Claude execution gate — auto-loaded alongside root CLAUDE.md (6-stage approval, start/finish gates)"
        },
        {
          "path": "AGENTS.md",
          "description": "Common agent operation rules"
        },
        {
          "path": "STATE.md",
          "description": "Current state and handoff record"
        },
        {
          "path": "DESIGN.md",
          "description": "Design system catalog — 1st source for UI/style work (tokens, components, Do/Don't, dark alias)"
        }
      ]
    },
    "L2_skills": {
      "description": "자연어 트리거 기반 자동 활성화 SKILL.md (description 키워드 매칭)",
      "files": [
        {
          "path": ".claude/skills/start/SKILL.md",
          "description": "New project setup QnA"
        },
        {
          "path": ".claude/skills/dev-start/SKILL.md",
          "description": "Dev session bootstrap — state briefing + dev container up + hot reload/UI·logic check"
        },
        {
          "path": ".claude/skills/intake/SKILL.md",
          "description": "Topic intake router (12 types)"
        },
        {
          "path": ".claude/skills/request/SKILL.md",
          "description": "Auto-classify work request type (activates only when ambiguous)"
        },
        {
          "path": ".claude/skills/feature/SKILL.md",
          "description": "Feature request form"
        },
        {
          "path": ".claude/skills/bugfix/SKILL.md",
          "description": "Bug fix request form"
        },
        {
          "path": ".claude/skills/refactor/SKILL.md",
          "description": "Refactor request form"
        },
        {
          "path": ".claude/skills/review/SKILL.md",
          "description": "Code review request form"
        },
        {
          "path": ".claude/skills/business-logic/SKILL.md",
          "description": "Business logic change request"
        },
        {
          "path": ".claude/skills/design/SKILL.md",
          "description": "Design system enforcement — auto-loads DESIGN.md on UI keywords"
        },
        {
          "path": ".claude/skills/stack-upgrade/SKILL.md",
          "description": "Stack version audit and safe dependency/infrastructure upgrades"
        },
        {
          "path": ".claude/skills/git-cleanup/SKILL.md",
          "description": "Audit and finish unfinished commit/push/PR/merge/branch work"
        },
        {
          "path": ".claude/skills/session-end/SKILL.md",
          "description": "Session wrap-up — record history/next steps in STATE.md and clear all pending Git work"
        },
        {
          "path": ".claude/skills/session-coordination/SKILL.md",
          "description": "세션 충돌 조정 — 파일 점유·Docker 자원 격리"
        }
      ]
    },
    "L2_commands": {
      "description": "skills와 병존하는 명시적 slash command (사용자가 직접 호출)",
      "files": [
        {
          "path": ".claude/commands/start.md",
          "description": "/start — explicit invocation"
        },
        {
          "path": ".claude/commands/dev-start.md",
          "description": "/dev-start — explicit invocation"
        },
        {
          "path": ".claude/commands/intake.md",
          "description": "/intake [topic] — explicit invocation"
        },
        {
          "path": ".claude/commands/request.md",
          "description": "/request [desc] — explicit invocation"
        },
        {
          "path": ".claude/commands/feature.md",
          "description": "/feature [desc] — explicit invocation"
        },
        {
          "path": ".claude/commands/bugfix.md",
          "description": "/bugfix [desc] — explicit invocation"
        },
        {
          "path": ".claude/commands/refactor.md",
          "description": "/refactor [desc] — explicit invocation"
        },
        {
          "path": ".claude/commands/review.md",
          "description": "/review [target] — explicit invocation"
        },
        {
          "path": ".claude/commands/business-logic.md",
          "description": "/business-logic [desc] — explicit invocation"
        },
        {
          "path": ".claude/commands/design.md",
          "description": "/design [component] — explicit invocation"
        },
        {
          "path": ".claude/commands/stack-upgrade.md",
          "description": "/stack-upgrade [target] — explicit invocation"
        },
        {
          "path": ".claude/commands/git-cleanup.md",
          "description": "/git-cleanup [branch|PR] — explicit invocation"
        },
        {
          "path": ".claude/commands/session-end.md",
          "description": "/session-end [state|git] — explicit invocation"
        },
        {
          "path": ".claude/commands/session-coordination.md",
          "description": "/session-coordination [status|claim|release] — explicit invocation"
        }
      ]
    },
    "L3_hooks": {
      "description": "자동 가드레일 스크립트와 작업 알림 스크립트",
      "files": [
        {
          "path": ".claude/hooks/block-destructive.sh",
          "description": "Block rm -rf, git reset --hard, etc."
        },
        {
          "path": ".claude/hooks/block-deploy.sh",
          "description": "Block deploy/release commands — deployment is always manual"
        },
        {
          "path": ".claude/hooks/block-secret-files.sh",
          "description": "Block writing to .env, *.pem, *.key"
        },
        {
          "path": ".claude/hooks/state-reminder.sh",
          "description": "Warn if STATE.md not updated on commit"
        },
        {
          "path": ".claude/hooks/phase-approval.sh",
          "description": "Block Claude edits before Step 3 approval and from main worktree"
        },
        {
          "path": ".claude/hooks/session-coordination.sh",
          "description": "Register sessions and ask before overlapping file edits"
        },
        {
          "path": ".claude/hooks/warn-design-tokens.sh",
          "description": "Opt-in: warn on hex/non-4px usage in CSS/JSX (not registered by default)"
        },
        {
          "path": ".claude/hooks/notify-desktop.sh",
          "description": "Desktop toast + sound dispatcher (WSL/Windows, macOS, Linux)"
        },
        {
          "path": ".claude/hooks/notify-pending.sh",
          "description": "Stop/Notification: register waiting state, alert, repeat until acknowledged (async hook)"
        },
        {
          "path": ".claude/hooks/notify-ack.sh",
          "description": "UserPromptSubmit/SessionEnd: clear waiting state and stop repeat alerts"
        },
        {
          "path": ".claude/statusline-notify.sh",
          "description": "Status line: show which other windows are waiting for a response"
        }
      ],
      "settings": ".claude/settings.template.json"
    },
    "L4_subagents": {
      "description": "Agent 도구 호출용 프롬프트 템플릿",
      "files": [
        {
          "path": ".claude/agents/explorer.md",
          "description": "Investigation/exploration agent"
        },
        {
          "path": ".claude/agents/code-reviewer.md",
          "description": "Code review against repo conventions"
        },
        {
          "path": ".claude/agents/planner.md",
          "description": "Design/planning agent"
        },
        {
          "path": ".claude/agents/test-runner.md",
          "description": "Test execution and failure analysis"
        },
        {
          "path": ".claude/agents/feature-dev.md",
          "description": "End-to-end feature implementation"
        },
        {
          "path": ".claude/agents/design-reviewer.md",
          "description": "Design consistency review against DESIGN.md tokens and Do/Don't"
        }
      ]
    }
  },
  "designs": {
    "description": "Design system catalog library — root DESIGN.md는 라이브러리에서 선택된 시안의 활성 사본",
    "default": "wanted",
    "files": [
